{
  "name": "[avd-ops] Greenfield M365 VDI Productivity Baseline",
  "oneDrive": {
    "silentAccountConfig": true,
    "knownFolderMove": [
      "Desktop",
      "Documents",
      "Pictures"
    ],
    "filesOnDemand": true
  },
  "teamsVdi": {
    "vdiMediaOptimization": "SlimCoreAndWebRtc",
    "disableGpuHardwareAccelerationInSession": false
  },
  "m365Apps": {
    "sharedComputerLicensing": true,
    "updateChannel": "MonthlyEnterprise",
    "outlookCachedExchangeSyncMonths": 3
  },
  "sharePoint": {
    "sharingCapability": "existingExternalUserSharingOnly",
    "isUnmanagedSyncAppForTenantRestricted": false,
    "isResharingByExternalUsersEnabled": false,
    "isFileActivityNotificationEnabled": true,
    "idleSessionSignOut": {
      "isEnabled": true,
      "warnAfterInSeconds": 2700,
      "signOutAfterInSeconds": 3600
    },
    "excludedFileExtensionsForSyncApp": [
      ".pst",
      ".ost"
    ]
  },
  "cloudProfiles": {
    "commercial": {
      "sharePointSuffix": ".sharepoint.com",
      "teamsVdiDefaultMode": "SlimCore"
    },
    "usgov": {
      "sharePointSuffix": ".sharepoint.us",
      "teamsVdiDefaultMode": "WebRtc"
    }
  }
}
